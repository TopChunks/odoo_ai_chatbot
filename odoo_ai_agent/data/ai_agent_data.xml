<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Author of the AI's messages; archived like OdooBot so it stays out of contacts and mentions. -->
        <record id="partner_ai_agent" model="res.partner">
            <field name="name">AI Agent</field>
            <field name="active" eval="False"/>
            <field name="image_1920" type="base64" file="odoo_ai_agent/static/description/icon.svg"/>
        </record>

        <record id="provider_openai" model="ai_agent.provider">
            <field name="name">OpenAI</field>
            <field name="code">openai</field>
            <field name="sequence">10</field>
        </record>
        <record id="provider_gemini" model="ai_agent.provider">
            <field name="name">Google Gemini</field>
            <field name="code">gemini</field>
            <field name="sequence">20</field>
        </record>
        <record id="provider_anthropic" model="ai_agent.provider">
            <field name="name">Anthropic Claude</field>
            <field name="code">anthropic</field>
            <field name="sequence">30</field>
        </record>
        <record id="provider_openrouter" model="ai_agent.provider">
            <field name="name">OpenRouter</field>
            <field name="code">openrouter</field>
            <field name="sequence">40</field>
        </record>

    </data>
</odoo>
