<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Desktop: an "AI Agent" filter beside Notifications / Chats / Channels. -->
    <t t-inherit="mail.MessagingMenu.content" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-MessagingMenu-headerFilter')][contains(@t-on-click, &quot;'channel'&quot;)]" position="after">
            <button t-if="hasAiAgentAccess" class="o-mail-MessagingMenu-headerFilter o-ai-agent-headerFilter btn btn-link o-px-1_5 py-1 m-1 lh-1 position-relative" t-att-class="store.discuss.activeTab === 'ai_agent' ? 'fw-bold o-active shadow-sm' : 'text-muted'" type="button" role="tab" t-on-click="() => store.discuss.activeTab = 'ai_agent'">
                <i class="o-ai-agent-glyph me-1"/>AI Agent
            </button>
        </xpath>
        <!-- Preview the latest answer of an AI conversation, like a chat. -->
        <xpath expr="//t[@t-foreach='threads']/t[@t-set='message']" position="after">
            <t t-if="thread.isAiAgent" t-set="message" t-value="thread.newestPersistentOfAllMessage"/>
        </xpath>
    </t>
</templates>
