<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_agent_usage_view_list" model="ir.ui.view">
        <field name="name">ai_agent.usage.list</field>
        <field name="model">ai_agent.usage</field>
        <field name="arch" type="xml">
            <list string="AI Usage" create="false" edit="false" decoration-danger="state == 'error'">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="channel_id" optional="show"/>
                <field name="provider_id" optional="hide"/>
                <field name="model_id" optional="show"/>
                <field name="request_count" optional="hide"/>
                <field name="input_tokens" sum="Total"/>
                <field name="output_tokens" sum="Total"/>
                <field name="cached_tokens" optional="hide" sum="Total"/>
                <field name="total_tokens" optional="show" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="duration" optional="show"/>
                <field name="tool_call_count" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="ai_agent_usage_view_form" model="ir.ui.view">
        <field name="name">ai_agent.usage.form</field>
        <field name="model">ai_agent.usage</field>
        <field name="arch" type="xml">
            <form string="AI Usage" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="channel_id"/>
                            <field name="provider_id"/>
                            <field name="model_id"/>
                            <field name="model_code"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="request_count"/>
                            <field name="input_tokens"/>
                            <field name="cached_tokens"/>
                            <field name="output_tokens"/>
                            <field name="cost"/>
                            <field name="duration"/>
                            <field name="tool_call_count"/>
                            <field name="tool_error_count"/>
                            <field name="tools_used"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_agent_usage_view_pivot" model="ir.ui.view">
        <field name="name">ai_agent.usage.pivot</field>
        <field name="model">ai_agent.usage</field>
        <field name="arch" type="xml">
            <pivot string="AI Usage" sample="1">
                <field name="user_id" type="row"/>
                <field name="model_id" type="col"/>
                <field name="cost" type="measure"/>
                <field name="total_tokens" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ai_agent_usage_view_graph" model="ir.ui.view">
        <field name="name">ai_agent.usage.graph</field>
        <field name="model">ai_agent.usage</field>
        <field name="arch" type="xml">
            <graph string="AI Usage" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="ai_agent_usage_view_search" model="ir.ui.view">
        <field name="name">ai_agent.usage.search</field>
        <field name="model">ai_agent.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="provider_id"/>
                <filter name="filter_date" string="Date" date="date"/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'error')]"/>
                <filter name="answered" string="Answered" domain="[('state', '=', 'success')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_model" string="AI Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_agent_usage_action" model="ir.actions.act_window">
        <field name="name">Usage Analysis</field>
        <field name="res_model">ai_agent.usage</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_filter_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No AI usage yet</p>
            <p>Every question answered by the AI Agent is recorded here with its tokens and cost.</p>
        </field>
    </record>

    <record id="ai_agent_usage_dashboard_action" model="ir.actions.client">
        <field name="name">AI Usage Dashboard</field>
        <field name="tag">odoo_ai_agent.usage_dashboard</field>
    </record>
</odoo>
