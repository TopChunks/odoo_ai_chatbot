<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_agent_model_view_list" model="ir.ui.view">
        <field name="name">ai_agent.model.list</field>
        <field name="model">ai_agent.model</field>
        <field name="arch" type="xml">
            <list string="AI Models" editable="bottom" create="false" default_group_by="provider_id">
                <field name="provider_id" optional="hide"/>
                <field name="name"/>
                <field name="code"/>
                <field name="context_window" optional="show"/>
                <field name="input_price" optional="show"/>
                <field name="output_price" optional="show"/>
                <field name="cache_read_price" optional="hide"/>
                <field name="price_source" optional="hide"/>
                <field name="is_free" optional="show"/>
                <field name="last_seen" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_agent_model_view_form" model="ir.ui.view">
        <field name="name">ai_agent.model.form</field>
        <field name="model">ai_agent.model</field>
        <field name="arch" type="xml">
            <form string="AI Model" create="false">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <group>
                        <group string="Model">
                            <field name="provider_id" readonly="1"/>
                            <field name="context_window"/>
                            <field name="max_output_tokens"/>
                            <field name="is_free"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Prices (USD per 1M tokens)">
                            <field name="input_price"/>
                            <field name="output_price"/>
                            <field name="cache_read_price"/>
                            <field name="price_source"/>
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_agent_model_view_search" model="ir.ui.view">
        <field name="name">ai_agent.model.search</field>
        <field name="model">ai_agent.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="provider_id"/>
                <filter name="free" string="Free Model" domain="[('is_free', '=', True)]"/>
                <filter name="priced" string="Commercial Model" domain="[('is_free', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_agent_model_action" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">ai_agent.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI models yet</p>
            <p>Open an AI provider, enter its API key and click <b>Refresh available models</b>.</p>
        </field>
    </record>
</odoo>
