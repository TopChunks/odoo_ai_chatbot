<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The AI Agent app: the conversation list and the chat, opened on the latest conversation. -->
    <record id="ai_agent_home_action" model="ir.actions.client">
        <field name="name">AI Agent</field>
        <field name="tag">odoo_ai_agent.home</field>
        <field name="path">ai-agent</field>
    </record>

    <menuitem id="menu_ai_agent_root" name="AI Agent" sequence="6"
              web_icon="odoo_ai_agent,static/description/icon.svg"
              action="ai_agent_home_action"
              groups="group_ai_agent_user"/>

    <menuitem id="menu_ai_agent_reporting" name="Reporting" parent="menu_ai_agent_root" sequence="50"
              groups="group_ai_agent_manager"/>
    <menuitem id="menu_ai_agent_usage_dashboard" name="Usage &amp; Cost" parent="menu_ai_agent_reporting"
              action="ai_agent_usage_dashboard_action" sequence="10"/>

    <menuitem id="menu_ai_agent_configuration" name="Configuration" parent="menu_ai_agent_root" sequence="90"
              groups="group_ai_agent_manager"/>
    <menuitem id="menu_ai_agent_settings" name="Settings" parent="menu_ai_agent_configuration"
              action="ai_agent_settings_action" sequence="10"/>
</odoo>
