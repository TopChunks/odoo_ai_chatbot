<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="export_document">
        <t t-out="'&lt;!DOCTYPE html&gt;'"/>
        <html>
            <head>
                <meta charset="utf-8"/>
                <title t-esc="title"/>
                <style>
                    body { font-family: "Helvetica Neue", Arial, sans-serif; color: #1f2937; font-size: 12px; margin: 0; }
                    .head { border-bottom: 3px solid #4F46E5; padding-bottom: 8px; margin-bottom: 14px; }
                    .head h1 { font-size: 20px; margin: 0 0 4px 0; color: #111827; }
                    .meta { color: #6b7280; font-size: 11px; }
                    .chart { text-align: center; margin: 10px 0 18px 0; }
                    .chart img { max-width: 100%; max-height: 420px; }
                    table { width: 100%; border-collapse: collapse; page-break-inside: auto; }
                    tr { page-break-inside: avoid; }
                    th { background: #EEF2FF; color: #312E81; text-align: left; padding: 6px 8px; border-bottom: 1px solid #C7D2FE; }
                    td { padding: 5px 8px; border-bottom: 1px solid #E5E7EB; }
                    tr:nth-child(even) td { background: #F9FAFB; }
                    .num { text-align: right; white-space: nowrap; }
                    .foot { margin-top: 14px; color: #9ca3af; font-size: 10px; }
                </style>
            </head>
            <body>
                <div class="head">
                    <h1 t-esc="title"/>
                    <div class="meta">
                        <t t-esc="subtitle"/> · <t t-esc="company.name"/> · <t t-esc="user.name"/> · <t t-esc="date"/>
                    </div>
                </div>
                <div t-if="image" class="chart"><img t-att-src="image"/></div>
                <table t-if="rows">
                    <thead>
                        <tr>
                            <th t-foreach="headers" t-as="header" t-att-class="'num' if numeric and numeric[header_index] else ''" t-esc="header"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row">
                            <td t-foreach="row" t-as="cell" t-att-class="'num' if numeric and numeric[cell_index] else ''" t-esc="cell"/>
                        </tr>
                    </tbody>
                </table>
                <p t-else="">No data.</p>
                <div class="foot">Generated by AI Agent from Odoo data you can access.</div>
            </body>
        </html>
    </template>
</odoo>
