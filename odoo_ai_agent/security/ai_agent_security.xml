<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own "AI" section on the user's Access Rights tab (Settings > Users). -->
    <record id="module_category_ai_agent" model="ir.module.category">
        <field name="name">AI</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_ai_agent" model="res.groups.privilege">
        <field name="name">AI Agent</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ai_agent"/>
    </record>

    <record id="group_ai_agent_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_agent"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can chat with the AI Agent. The AI only reads and changes what this user may read and change in Odoo, and every change must be confirmed.</field>
    </record>

    <record id="group_ai_agent_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_agent"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_agent_user'))]"/>
        <field name="comment">Can configure AI providers, API keys and models, and see the usage and cost reports of every user.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_ai_agent_usage_own" model="ir.rule">
            <field name="name">AI usage: own records</field>
            <field name="model_id" ref="model_ai_agent_usage"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_agent_user'))]"/>
        </record>
        <record id="rule_ai_agent_usage_all" model="ir.rule">
            <field name="name">AI usage: all records</field>
            <field name="model_id" ref="model_ai_agent_usage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_agent_manager'))]"/>
        </record>
    </data>
</odoo>
