<odoo>
    <record id="assistant_action" model="ir.actions.client">
        <field name="name">AI Assistant</field>
        <field name="tag">odoo_ai_assistant.assistant</field>
    </record>
    <record id="usage_dashboard_action" model="ir.actions.client">
        <field name="name">Usage</field>
        <field name="tag">odoo_ai_assistant.usage_dashboard</field>
    </record>
    <record id="settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'odoo_ai_assistant'}</field>
    </record>
    <menuitem id="assistant_menu" name="AI Assistant" action="assistant_action" sequence="15" groups="group_ai_user,base.group_system,-base.group_user" web_icon="odoo_ai_assistant,static/description/icon.svg"/>

    <menuitem id="assistant_reporting_menu" name="Reporting" parent="assistant_menu" groups="base.group_system" sequence="80"/>
    <menuitem id="assistant_usage_menu" name="Usage" parent="assistant_reporting_menu" action="usage_dashboard_action" sequence="10"/>

    <menuitem id="assistant_configuration_menu" name="Configuration" parent="assistant_menu" groups="base.group_system" sequence="90"/>
    <menuitem id="assistant_settings_menu" name="Settings" parent="assistant_configuration_menu" action="settings_action" sequence="10"/>
</odoo>
