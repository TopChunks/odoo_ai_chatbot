<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- PDF export of a chat chart or table (models/chart_export.py). -->
    <template id="chart_export_pdf">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    body { font-family: sans-serif; font-size: 12px; }
                    img { max-width: 100%; margin: 12px 0; }
                    table { border-collapse: collapse; width: 100%; }
                    th, td { border-bottom: 1px solid #dee2e6; padding: 4px 8px; text-align: left; }
                    th { font-weight: bold; }
                </style>
            </head>
            <body>
                <h2 t-esc="title"/>
                <img t-if="image" t-att-src="image"/>
                <table>
                    <thead><tr><th t-foreach="headers" t-as="header" t-esc="header"/></tr></thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row"><td t-foreach="row" t-as="cell" t-esc="cell"/></tr>
                    </tbody>
                </table>
            </body>
        </html>
    </template>
</odoo>
