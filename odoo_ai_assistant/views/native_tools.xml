<odoo>
    <record id="native_request_list" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.tool.request.list</field>
        <field name="model">odoo.ai.assistant.tool.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/><field name="user_id"/><field name="company_id"/>
                <field name="tool"/><field name="mutation"/><field name="state"/>
                <field name="provider"/><field name="expires_at"/>
            </list>
        </field>
    </record>
    <record id="native_request_form" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.tool.request.form</field>
        <field name="model">odoo.ai.assistant.tool.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group><field name="user_id"/><field name="conversation_id"/><field name="company_id"/>
                        <field name="tool"/><field name="state"/><field name="mutation"/>
                        <field name="provider"/><field name="provider_model"/><field name="expires_at"/></group>
                    <group string="Local audit data (may contain business information)">
                        <field name="arguments"/><field name="resolution_plan"/><field name="resolution_snapshot"/>
                        <field name="snapshot"/><field name="result"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="native_request_action" model="ir.actions.act_window">
        <field name="name">AI Tool Requests</field>
        <field name="res_model">odoo.ai.assistant.tool.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="native_event_list" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.tool.event.list</field>
        <field name="model">odoo.ai.assistant.tool.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/><field name="user_id"/><field name="tool"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="native_event_action" model="ir.actions.act_window">
        <field name="name">AI Tool Audit</field>
        <field name="res_model">odoo.ai.assistant.tool.event</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="native_request_menu" name="Tool Requests" parent="assistant_reporting_menu" action="native_request_action" sequence="20"/>
    <menuitem id="native_event_menu" name="Tool Audit" parent="assistant_reporting_menu" action="native_event_action" sequence="30"/>
</odoo>
