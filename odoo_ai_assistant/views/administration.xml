<odoo>
    <record id="usage_list" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.usage.list</field>
        <field name="model">odoo.ai.assistant.usage</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="status == 'failed'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="purpose"/>
                <field name="status"/>
                <field name="api_calls" sum="API attempts"/>
                <field name="tokens_known"/>
                <field name="input_tokens" sum="Known input tokens"/>
                <field name="output_tokens" sum="Known output tokens"/>
                <field name="cached_tokens" optional="hide"/>
                <field name="cache_write_tokens" optional="hide"/>
                <field name="total_tokens" sum="Known tokens"/>
                <field name="duration_ms" optional="hide"/>
                <field name="http_status" optional="hide"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="usage_form" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.usage.form</field>
        <field name="model">odoo.ai.assistant.usage</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <div class="alert alert-info" role="status">Token counts come from the provider's response. Catalogue requests and failed/time-out calls may have no reported tokens. Pending entries indicate an attempt without a recorded response. No prompts, keys or record results are stored here.</div>
                <sheet>
                    <group>
                        <group><field name="create_date"/><field name="user_id"/><field name="provider"/><field name="model_name"/><field name="purpose"/><field name="status"/><field name="http_status"/><field name="duration_ms"/></group>
                        <group><field name="tokens_known"/><field name="input_tokens"/><field name="output_tokens"/><field name="cached_tokens"/><field name="cache_write_tokens"/><field name="total_tokens"/><field name="note"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="usage_pivot" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.usage.pivot</field>
        <field name="model">odoo.ai.assistant.usage</field>
        <field name="arch" type="xml">
            <pivot string="AI usage">
                <field name="user_id" type="row"/>
                <field name="purpose" type="col"/>
                <field name="api_calls" type="measure"/>
                <field name="total_tokens" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="usage_graph" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.usage.graph</field>
        <field name="model">odoo.ai.assistant.usage</field>
        <field name="arch" type="xml">
            <graph string="API attempts across users" type="bar">
                <field name="create_date" interval="day"/>
                <field name="api_calls" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="usage_search" model="ir.ui.view">
        <field name="name">odoo.ai.assistant.usage.search</field>
        <field name="model">odoo.ai.assistant.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/><field name="provider"/><field name="model_name"/>
                <filter name="failed" string="Failed calls" domain="[('status', '=', 'failed')]"/>
                <filter name="date" string="Date" date="create_date"/>
                <group><filter name="by_user" string="User" context="{'group_by': 'user_id'}"/><filter name="by_provider" string="Provider" context="{'group_by': 'provider'}"/><filter name="by_model" string="Model" context="{'group_by': 'model_name'}"/><filter name="by_purpose" string="Purpose" context="{'group_by': 'purpose'}"/></group>
            </search>
        </field>
    </record>
    <record id="usage_action" model="ir.actions.act_window">
        <field name="name">AI Usage Log</field>
        <field name="res_model">odoo.ai.assistant.usage</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="help" type="html"><p>Every AI request is recorded here with its tokens.</p></field>
    </record>
</odoo>
