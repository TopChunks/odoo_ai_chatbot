<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.Systray">
        <div t-if="state.enabled" class="o_ai_systray">
            <!-- Drawn like Odoo's own systray icons, so it takes the navbar's colours in any theme. -->
            <button class="o_nav_entry btn border-0" title="Ask AI" aria-label="Open AI Agent" t-on-click="() => ai.open()">
                <i class="fa fa-lg fa-magic" role="img" aria-label="AI magic wand"/>
            </button>
        </div>
    </t>
    <t t-name="odoo_ai_assistant.Overlay">
        <div t-if="state.open" class="o_ai_popup shadow-lg" t-att-class="{'o_ai_minimized': state.minimized}" t-att-style="size.width &amp;&amp; !state.minimized ? 'width:' + size.width + 'px;height:' + size.height + 'px' : ''" role="dialog" aria-label="AI Agent" t-on-keydown="keydown">
            <AssistantPanel/>
            <div t-if="!state.minimized" class="o_ai_resize_handle" title="Drag to resize chat" aria-label="Resize chat" t-on-pointerdown="startResize" t-on-pointermove="resize" t-on-pointerup="stopResize" t-on-pointercancel="stopResize"><i class="fa fa-expand"/></div>
        </div>
    </t>
    <t t-name="odoo_ai_assistant.Action">
        <div class="o_ai_action h-100"><AssistantPanel full="true"/></div>
    </t>
    <!-- A staged file, drawn like Discuss's attachment cards; the body (t-out 0) holds extra buttons. -->
    <t t-name="odoo_ai_assistant.FileCard">
        <div class="o_ai_file_card d-flex flex-column border rounded-3 overflow-hidden" t-att-title="file.name">
            <div class="o_ai_file_preview d-flex justify-content-center align-items-center bg-white">
                <img t-if="file.thumbnail" t-att-src="file.thumbnail" t-att-alt="file.name"/>
                <div t-else="" class="o_image" t-att-data-mimetype="file.mimetype"/>
            </div>
            <div class="d-flex align-items-center gap-2 px-2 py-1 bg-200">
                <div class="o_ai_file_icon o_image flex-shrink-0" t-att-data-mimetype="file.mimetype"/>
                <span class="text-truncate fw-bold small flex-grow-1" t-esc="file.name"/>
                <t t-out="0"/>
            </div>
        </div>
    </t>
    <t t-name="odoo_ai_assistant.Panel">
        <section class="o_ai_panel d-flex flex-column h-100">
            <header class="o_ai_header d-flex align-items-center gap-2 px-2 py-1 border-bottom">
                <img src="/odoo_ai_assistant/static/description/icon.svg" alt="" width="28" height="28"/>
                <div class="flex-grow-1 overflow-hidden">
                    <strong class="d-block text-truncate" t-esc="state.assistant_name"/>
                </div>
                <button class="btn btn-sm btn-light" title="New conversation" aria-label="New conversation" t-on-click="() => ai.newChat()" t-att-disabled="state.busy || !state.enabled"><i class="fa fa-plus"/></button>
                <t t-if="!props.full">
                    <button class="btn btn-sm btn-light" title="Expand into Discuss" aria-label="Expand into Discuss" t-on-click="expand" t-att-disabled="state.busy"><i class="fa fa-expand"/></button>
                    <button class="btn btn-sm btn-light" title="Minimize or restore" aria-label="Minimize or restore chat" t-on-click="toggleMinimized"><i class="fa fa-minus"/></button>
                    <button class="btn btn-sm btn-light" title="Close" aria-label="Close chat" t-on-click="() => state.open = false"><i class="fa fa-times"/></button>
                </t>
            </header>
            <div t-if="state.showResume &amp;&amp; state.previousChat &amp;&amp; (!state.minimized || props.full)" class="o_ai_resume d-flex align-items-center gap-1 px-3 py-2" role="status">
                <span>New chat started.</span>
                <button class="btn btn-link p-0 fw-bold" t-on-click="() => ai.resumePrevious()" t-att-disabled="state.busy">Resume previous chat <i class="fa fa-angle-right ms-1"/></button>
                <button class="btn btn-link ms-auto p-0" title="Dismiss" aria-label="Dismiss resume previous chat" t-on-click="() => state.showResume = false"><i class="fa fa-times"/></button>
            </div>
            <div t-if="!state.enabled" class="p-4">
                <h4>AI Agent is not enabled</h4>
                <p class="text-muted">Ask your administrator to enable AI Settings and grant AI Agent access on your user.</p>
            </div>
            <div t-elif="!state.minimized || props.full" class="o_ai_workspace d-flex flex-grow-1 overflow-hidden">
                <aside t-if="props.full" class="o_ai_history border-end d-flex flex-column">
                    <div class="o_ai_history_controls d-flex align-items-center gap-2 p-3">
                        <button class="o_ai_new_chat btn btn-primary flex-shrink-0" title="New conversation" aria-label="Create AI conversation" t-on-click="() => ai.newChat()" t-att-disabled="state.busy"><i class="fa fa-plus me-2"/>Chat</button>
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text border-end-0 bg-transparent"><i class="fa fa-search"/></span>
                            <input class="form-control border-start-0" placeholder="Search Conversation" aria-label="Search Conversation" t-model="input.search"/>
                        </div>
                    </div>
                    <div class="o_ai_filters d-flex gap-3 px-3 border-bottom" role="group" aria-label="Conversation filters">
                        <button class="btn btn-sm rounded-0" t-att-class="{'o_ai_filter_active': input.filter === 'all'}" t-att-aria-pressed="input.filter === 'all' ? 'true' : 'false'" t-on-click="() => input.filter = 'all'">All</button>
                        <button class="btn btn-sm rounded-0" t-att-class="{'o_ai_filter_active': input.filter === 'unread'}" t-att-aria-pressed="input.filter === 'unread' ? 'true' : 'false'" t-on-click="() => input.filter = 'unread'">Unread</button>
                    </div>
                    <div class="o_ai_conversations flex-grow-1 overflow-auto py-1">
                        <div t-if="!filteredConversations.length" class="text-muted small p-2">No matching conversations.</div>
                        <div t-foreach="filteredConversations" t-as="chat" t-key="chat.id" class="o_ai_conversation_row d-flex align-items-center" t-att-class="{'o_ai_conversation_selected': state.current?.id === chat.id}">
                            <button class="btn text-start flex-grow-1 overflow-hidden" t-on-click="() => ai.select(chat)" t-att-disabled="state.busy" t-att-title="chat.name">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="/odoo_ai_assistant/static/description/icon.svg" class="o_ai_avatar" alt="" width="40" height="40"/>
                                    <div class="overflow-hidden flex-grow-1">
                                        <div class="d-flex gap-2"><strong class="text-truncate flex-grow-1" t-esc="chat.name"/><small class="text-muted flex-shrink-0" t-esc="conversationDate(chat)"/></div>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="small text-muted text-truncate flex-grow-1" t-esc="chat.preview"/>
                                            <i t-if="state.replying[chat.id]" class="fa fa-circle-o-notch fa-spin text-muted" role="img" aria-label="Answering"/>
                                            <!-- Odoo's own unread counter, as on its chats -->
                                            <span t-elif="chat.unread" class="badge rounded-pill o-discuss-badge fw-bold shadow-sm flex-shrink-0" t-esc="chat.unread"/>
                                        </div>
                                    </div>
                                </div>
                            </button>
                            <button class="btn btn-sm text-muted o_ai_delete" title="Delete conversation" aria-label="Delete conversation" t-on-click="() => this.deleteChat(chat)" t-att-disabled="state.busy || state.replying[chat.id]"><i class="fa fa-trash-o"/></button>
                        </div>
                    </div>
                </aside>
                <main class="d-flex flex-column flex-grow-1 overflow-hidden">
                    <header t-if="props.full" class="o_ai_thread_header d-flex align-items-center gap-2 px-3 py-2 border-bottom flex-shrink-0">
                        <img src="/odoo_ai_assistant/static/description/icon.svg" alt="" width="28" height="28"/>
                        <strong class="text-truncate flex-grow-1" t-esc="state.current?.name || state.assistant_name"/>
                        <span t-if="state.can_change_model" class="o_ai_model_select" title="AI model for this conversation only; new conversations use the AI Settings model">
                            <SelectMenu choices="modelChoices" value="currentModel.value" searchable="true" required="true"
                                        disabled="state.busy" onOpened.bind="loadModelChoices" onSelect.bind="selectModel"
                                        togglerClass="'btn btn-sm btn-light text-muted'" searchPlaceholder.translate="Search models"/>
                        </span>
                        <small t-else="" class="text-muted text-truncate" t-esc="currentModel.label"/>
                    </header>
                    <div class="o_ai_messages flex-grow-1 overflow-auto p-3" t-att-class="{'o_ai_messages_empty': !state.messages.length}" t-ref="messages" t-on-scroll="onMessagesScroll" aria-live="polite" t-att-aria-busy="busy ? 'true' : 'false'">
                        <div t-if="!state.messages.length" class="o_ai_welcome">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <img src="/odoo_ai_assistant/static/description/icon.svg" alt="Colorful magic wand" width="44" height="44"/>
                                <h2 class="mb-0" t-esc="state.assistant_name"/>
                            </div>
                            <p class="text-muted small mb-3">Ask about your Odoo apps, explore your data with charts, and prepare changes you confirm.</p>
                            <div t-if="state.suggestions.length" class="o_ai_suggestions d-flex flex-column align-items-start gap-2">
                                <button t-foreach="state.suggestions" t-as="suggestion" t-key="suggestion_index" class="btn btn-light btn-sm" t-on-click="() => this.suggest(suggestion)" t-att-disabled="busy" t-esc="suggestion"/>
                            </div>
                        </div>
                        <t t-foreach="state.messages" t-as="message" t-key="message.id">
                            <DateSection t-if="startsNewDay(message_index)" date="messageDay(message)" className="'o_ai_date_section pt-2 pb-3 px-2'"/>
                            <div class="o_ai_message d-flex gap-2 mb-3" t-att-class="{'o_ai_user': message.role === 'user'}">
                                <img t-if="message.role === 'assistant'" src="/odoo_ai_assistant/static/description/icon.svg" class="o_ai_message_avatar" alt="" width="32" height="32"/>
                                <span t-else="" class="o_ai_message_avatar o_ai_user_avatar" t-att-title="userName" aria-hidden="true" t-esc="userInitial"/>
                                <div class="o_ai_message_content flex-grow-1">
                                    <t t-set="payload" t-value="messagePayload(message)"/>
                                    <t t-set="content" t-value="messageContent(message)"/>
                                    <t t-set="formatted" t-value="messageHTML(message)"/>
                                    <div class="o_ai_message_meta small text-muted mb-1">
                                        <strong t-esc="message.role === 'user' ? userName : state.assistant_name"/>
                                        <time t-if="message.create_date" class="ms-1" t-att-datetime="message.create_date.replace(' ', 'T') + 'Z'" t-att-title="messageDateTitle(message)" t-esc="messageTime(message)"/>
                                        <span t-if="message.provider_sensitive || payload?.state === 'shared'" class="badge text-bg-warning ms-2">Shared with provider</span>
                                        <span t-elif="message.local_only || payload" class="badge text-bg-success ms-2"><i class="fa fa-lock me-1"/>Local only</span>
                                    </div>
                                    <details t-if="message.execution_steps?.length" class="small text-muted mb-2">
                                        <summary>Steps taken</summary>
                                        <ol class="mt-1 mb-0"><li t-foreach="message.execution_steps" t-as="step" t-key="step_index" t-esc="step"/></ol>
                                    </details>
                                    <LocalVisualization t-if="payload" payload="payload" busy="busy"
                                        onConfirm="(id) => ai.toolAction('confirm_tool', id)"
                                        onCancel="(id) => ai.toolAction('cancel_tool', id)"
                                        onShare="(id) => this.shareResult(id)"
                                        onPage="(previous) => ai.loadRecordPage(message.id, previous)"
                                        onExport="(format, image) => ai.exportChart(message.id, format, image)"/>
                                    <div t-if="formatted" class="o_ai_bubble o_ai_formatted o-mail-Message-bubble border o-rounded-bubble" t-att-class="{'o-green': message.role === 'user', 'o-blue': message.role === 'assistant'}" t-out="formatted"/>
                                    <div t-elif="content" class="o_ai_bubble o-mail-Message-bubble border o-rounded-bubble" t-att-class="{'o-green': message.role === 'user', 'o-blue': message.role === 'assistant'}" t-esc="content"/>
                                    <!-- Odoo's own buttons, without an action: shown as they look, never clickable. -->
                                    <div t-if="message.payload?.kind === 'apps' and message.payload.buttons?.length" class="o_ai_buttons border rounded mt-2">
                                        <div t-foreach="message.payload.buttons" t-as="button" t-key="button_index"
                                             class="d-flex align-items-center gap-3 px-3 py-2" t-att-class="{'border-top': !button_first}">
                                            <div class="d-flex flex-wrap gap-1 flex-shrink-0">
                                                <ViewButton t-foreach="button.looks" t-as="look" t-key="look_index"
                                                            string="button.label" className="look.classes" icon="look.icon" size="'sm'"/>
                                            </div>
                                            <div class="small text-muted min-w-0">
                                                <div class="text-truncate" t-att-title="button.screens.join('\n')"><t t-esc="button.screens.join(', ')"/> · <t t-esc="button.views.join(', ')"/></div>
                                                <div t-if="button.visibility === 'conditional'">Shown only in some cases</div>
                                                <div t-if="button.looks.length > 1">Its look depends on the situation</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div t-if="message.payload?.kind === 'apps' and message.payload.apps.length" class="o_ai_apps d-flex flex-wrap gap-2 mt-2">
                                        <a t-foreach="messageApps(message)" t-as="app" t-key="app.id" t-att-href="app.href"
                                           class="btn btn-light border d-flex align-items-center gap-2"
                                           t-on-click.prevent="() => menu.selectMenu(app.id)">
                                            <img t-if="app.webIconData" class="o_app_icon rounded-1" t-att-src="app.webIconData" alt=""/>
                                            <span t-else="" class="o_app_icon rounded-1 d-flex align-items-center justify-content-center"
                                                  t-attf-style="background-color: {{app.webIcon.backgroundColor}}">
                                                <i t-att-class="app.webIcon.iconClass" t-attf-style="color: {{app.webIcon.color}}"/>
                                            </span>
                                            <span t-esc="app.label"/>
                                        </a>
                                    </div>
                                    <div t-if="message.payload?.kind === 'files'" class="o_ai_files d-flex flex-wrap gap-2 mt-2">
                                        <t t-foreach="message.payload.files" t-as="file" t-key="file_index">
                                            <t t-call="odoo_ai_assistant.FileCard"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <div t-if="busy" class="text-muted" role="status"><i class="fa fa-circle-o-notch fa-spin me-2"/><t t-esc="state.progress || state.replying[state.current?.id] || 'Working...'"/></div>
                        <div t-if="state.error" class="alert alert-danger mt-3" role="alert" t-esc="state.error"/>
                    </div>
                    <footer class="o_ai_footer px-3 pb-2 pt-1">
                        <div t-if="voice.recording" class="small text-muted mb-2" role="status"><i class="fa fa-circle text-danger me-1"/>Listening... <span t-esc="voice.interim"/></div>
                        <div t-if="voice.error" class="small text-danger mb-2" role="alert" t-esc="voice.error"/>
                        <button t-if="scrollState.awayFromBottom" class="o_ai_jump_latest btn btn-light rounded-circle border shadow-sm" title="Jump to latest message" aria-label="Jump to latest message" t-on-click="jumpToLatest"><i class="fa fa-chevron-down"/></button>
                        <div t-if="input.files.length" class="o_ai_files d-flex flex-wrap gap-2 mb-2">
                            <t t-foreach="input.files" t-as="file" t-key="file.reference">
                                <t t-call="odoo_ai_assistant.FileCard">
                                    <button class="btn btn-link btn-sm p-0 text-muted" title="Remove" aria-label="Remove file" t-on-click="() => this.removeFile(file_index)" t-att-disabled="busy"><i class="fa fa-times"/></button>
                                </t>
                            </t>
                        </div>
                        <div class="d-flex align-items-end gap-2">
                            <span class="o_ai_message_avatar o_ai_user_avatar" t-att-title="userName" aria-label="Your avatar" t-esc="userInitial"/>
                            <div class="o_ai_composer d-flex flex-grow-1 align-items-end border px-2 py-1 gap-2">
                                <!-- Same "+" menu as the Discuss composer, with only the actions this chat supports. -->
                                <Dropdown position="'top-start'" menuClass="'o-discuss-dropdownMenu d-flex flex-column'" disabled="busy">
                                    <button class="o_ai_composer_action btn btn-sm" title="More Actions" aria-label="More Actions"><i class="fa fa-plus-circle"/></button>
                                    <t t-set-slot="content">
                                        <DropdownItem class="'d-flex align-items-center gap-1'" onSelected="() => this.toggleVoice()"><i class="fa fa-fw fa-microphone"/>Voice Message</DropdownItem>
                                        <DropdownItem t-if="state.can_stage_files" class="'d-flex align-items-center gap-1'" onSelected="() => this.fileInputRef.el?.click()"><i class="fa fa-fw fa-paperclip"/>Attach Files</DropdownItem>
                                    </t>
                                </Dropdown>
                                <input type="file" class="d-none" t-ref="fileInput" aria-label="Attach Files" t-on-change="attachFile"/>
                                <textarea class="form-control border-0 shadow-none" t-attf-placeholder="Message {{state.assistant_name}}..." t-att-aria-label="'Message ' + state.assistant_name" rows="1" t-att-maxlength="state.max_message_chars" t-model="input.text" t-ref="composer" t-on-keydown="keydown" t-att-disabled="busy"/>
                                <button t-if="voice.recording" class="o_ai_composer_action btn btn-sm text-danger" title="Stop voice input (Alt+V)" aria-label="Stop voice input" aria-pressed="true" t-on-click="toggleVoice"><i class="fa fa-stop"/></button>
                                <button class="o_ai_send btn btn-sm" title="Send message" aria-label="Send message" t-on-click="send" t-att-disabled="busy || (!input.text.trim() &amp;&amp; !input.files.length)"><i class="fa fa-paper-plane"/></button>
                            </div>
                        </div>
                    </footer>
                </main>
            </div>
        </section>
    </t>
</templates>
