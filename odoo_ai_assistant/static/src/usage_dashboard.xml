<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.UsageDashboard">
        <div class="o_ai_usage o_action h-100 overflow-auto">
            <div class="o_ai_usage_inner mx-auto px-3 px-md-4 py-4">
                <header class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <div class="flex-grow-1">
                        <h2 class="mb-1">Usage</h2>
                        <div class="text-muted small">AI provider usage across all users.</div>
                    </div>
                    <div class="btn-group" role="group" aria-label="Period">
                        <button t-foreach="periods" t-as="period" t-key="period.key" class="btn btn-sm"
                                t-att-class="state.period === period.key ? 'btn-primary' : 'btn-outline-secondary'"
                                t-att-aria-pressed="state.period === period.key ? 'true' : 'false'"
                                t-att-disabled="state.loading" t-on-click="() => this.load(period.key)" t-esc="period.label"/>
                    </div>
                </header>

                <t t-set="data" t-value="state.data"/>
                <section t-if="data" class="o_ai_usage_cards row g-3 mb-4">
                    <t t-foreach="cards" t-as="card" t-key="card.key">
                        <div class="col-12 col-md-4">
                            <div class="o_ai_usage_card card h-100 border">
                                <div class="card-body">
                                    <div class="text-muted small mb-1" t-esc="card.label"/>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="o_ai_usage_value fw-bold" t-esc="card.value"/>
                                        <t t-set="delta" t-value="change(card.key)"/>
                                        <span t-if="delta" class="small" t-att-class="delta.up ? 'text-danger' : 'text-success'" t-att-title="comparisonTitle" t-esc="delta.text"/>
                                    </div>
                                    <div class="text-muted small mt-1" t-esc="card.detail"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </section>

                <section class="card border mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <h5 class="mb-0 flex-grow-1">Daily usage</h5>
                            <div class="btn-group" role="group" aria-label="Chart metric">
                                <button t-foreach="Object.entries(metrics)" t-as="metric" t-key="metric[0]" class="btn btn-sm"
                                        t-att-class="state.metric === metric[0] ? 'btn-secondary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.selectMetric(metric[0])" t-esc="metric[1].label"/>
                            </div>
                        </div>
                        <div class="o_ai_usage_chart position-relative">
                            <canvas t-ref="chart" t-att-class="{'d-none': !data?.daily.length}"/>
                            <div t-if="data and !data.daily.length" class="text-muted text-center py-5">No AI usage recorded in this period.</div>
                        </div>
                    </div>
                </section>

                <section t-if="data" class="card border mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <h5 class="mb-0 flex-grow-1">Breakdown</h5>
                            <div class="btn-group" role="group" aria-label="Breakdown">
                                <t t-foreach="breakdowns" t-as="option" t-key="option[0]">
                                    <button class="btn btn-sm" t-att-class="state.breakdown === option[0] ? 'btn-secondary' : 'btn-outline-secondary'"
                                            t-on-click="() => state.breakdown = option[0]" t-esc="option[1]"/>
                                </t>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr>
                                    <th>Name</th><th class="text-end">API calls</th><th class="text-end">Tokens</th>
                                    <th class="o_ai_usage_share">Share</th>
                                </tr></thead>
                                <tbody>
                                    <tr t-if="!breakdownRows.length"><td colspan="4" class="text-muted text-center py-3">No AI usage recorded in this period.</td></tr>
                                    <tr t-foreach="breakdownRows" t-as="row" t-key="row_index">
                                        <td class="text-truncate" t-esc="row.label"/>
                                        <td class="text-end" t-esc="formatNumber(row.calls)"/>
                                        <td class="text-end" t-esc="formatNumber(row.tokens)"/>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" role="progressbar" t-att-aria-valuenow="share(row)" aria-valuemin="0" aria-valuemax="100">
                                                    <div class="progress-bar" t-att-style="'width:' + share(row) + '%'"/>
                                                </div>
                                                <small class="text-muted" t-esc="share(row) + '%'"/>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <footer class="d-flex flex-wrap gap-3">
                    <button class="btn btn-secondary" t-on-click="openLog"><i class="fa fa-list me-1"/>Detailed request log</button>
                </footer>
            </div>
        </div>
    </t>
</templates>
