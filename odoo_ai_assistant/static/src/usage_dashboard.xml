<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_assistant.UsageDashboard">
        <div class="o_ai_usage o_action h-100 overflow-auto">
            <div class="o_ai_usage_inner mx-auto px-3 px-md-4 py-4">
                <header class="o_ai_usage_hero d-flex flex-wrap align-items-center gap-3 mb-4 p-4 rounded-4">
                    <img src="/odoo_ai_assistant/static/description/icon.svg" class="o_ai_usage_logo rounded-3" alt="" width="48" height="48"/>
                    <div class="flex-grow-1">
                        <h2 class="mb-1">Usage</h2>
                        <div class="o_ai_usage_subtitle small">What each person's AI requests cost, and who gets answers most efficiently.</div>
                    </div>
                    <div class="o_ai_usage_periods btn-group rounded-pill p-1" role="group" aria-label="Period">
                        <button t-foreach="periods" t-as="period" t-key="period.key" class="btn btn-sm rounded-pill border-0"
                                t-att-class="{'active': state.period === period.key}"
                                t-att-aria-pressed="state.period === period.key ? 'true' : 'false'"
                                t-att-disabled="state.loading" t-on-click="() => this.load(period.key)" t-esc="period.label"/>
                    </div>
                </header>

                <t t-set="data" t-value="state.data"/>
                <div t-if="data?.totals.unpriced_calls" class="alert alert-warning small" role="status">
                    <i class="fa fa-info-circle me-1"/><t t-esc="formatNumber(data.totals.unpriced_calls)"/> calls used a model with no known price, so the cost leaves them out. Click <strong>Refresh available models</strong> in AI Settings to update prices.
                </div>
                <section t-if="data" class="o_ai_usage_cards row g-3 mb-4">
                    <div t-foreach="cards" t-as="card" t-key="card.key" class="col-12 col-sm-6 col-xl-3">
                        <div class="o_ai_usage_card card h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                                    <span class="o_ai_usage_icon rounded-circle d-flex align-items-center justify-content-center"><i t-attf-class="fa {{card.icon}}"/></span>
                                    <t t-esc="card.label"/>
                                </div>
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="o_ai_usage_value fw-bold" t-esc="card.value"/>
                                    <t t-set="delta" t-value="change(card.key)"/>
                                    <span t-if="delta" class="small" t-att-class="delta.up ? 'text-danger' : 'text-success'" t-att-title="comparisonTitle" t-esc="delta.text"/>
                                </div>
                                <div class="text-muted small mt-1" t-esc="card.detail"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section t-if="highlights.length" class="row g-3 mb-4">
                    <div t-foreach="highlights" t-as="highlight" t-key="highlight.key" class="col-12 col-md-6">
                        <div class="o_ai_usage_highlight card h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <span class="o_ai_usage_icon o_ai_usage_icon_lg rounded-circle d-flex align-items-center justify-content-center"><i t-attf-class="fa {{highlight.icon}}"/></span>
                                <div class="min-w-0">
                                    <div class="text-muted small" t-esc="highlight.title"/>
                                    <div class="fw-bold text-truncate" t-esc="highlight.name"/>
                                    <div class="small text-muted" t-esc="highlight.detail"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="o_ai_usage_panel card mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <h5 class="mb-0 flex-grow-1">Daily usage</h5>
                            <div class="o_ai_usage_periods btn-group rounded-pill p-1" role="group" aria-label="Chart metric">
                                <button t-foreach="Object.entries(metrics)" t-as="metric" t-key="metric[0]" class="btn btn-sm rounded-pill border-0"
                                        t-att-class="{'active': state.metric === metric[0]}"
                                        t-on-click="() => this.selectMetric(metric[0])" t-esc="metric[1].label"/>
                            </div>
                        </div>
                        <div class="o_ai_usage_chart position-relative">
                            <canvas t-ref="chart" t-att-class="{'d-none': !data?.daily.length}"/>
                            <div t-if="data and !data.daily.length" class="text-muted text-center py-5">No AI usage recorded in this period.</div>
                        </div>
                    </div>
                </section>

                <section t-if="data" class="o_ai_usage_panel card mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <h5 class="mb-0 flex-grow-1">Breakdown</h5>
                            <div class="o_ai_usage_periods btn-group rounded-pill p-1" role="group" aria-label="Breakdown">
                                <button t-foreach="breakdowns" t-as="option" t-key="option[0]" class="btn btn-sm rounded-pill border-0"
                                        t-att-class="{'active': state.breakdown === option[0]}"
                                        t-on-click="() => state.breakdown = option[0]" t-esc="option[1]"/>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr>
                                    <th>Name</th><th class="text-end">Answers</th><th class="text-end">Tokens</th>
                                    <th class="text-end">Cost</th><th class="text-end">Cost per answer</th>
                                    <th class="text-end">Failed</th><th class="o_ai_usage_share">Share of cost</th>
                                </tr></thead>
                                <tbody>
                                    <tr t-if="!breakdownRows.length"><td colspan="7" class="text-muted text-center py-3">No AI usage recorded in this period.</td></tr>
                                    <tr t-foreach="breakdownRows" t-as="row" t-key="row_index">
                                        <td class="text-truncate" t-esc="row.label"/>
                                        <td class="text-end" t-esc="formatNumber(row.answers)"/>
                                        <td class="text-end" t-esc="formatNumber(row.tokens)"/>
                                        <td class="text-end fw-bold" t-esc="formatMoney(row.cost)"/>
                                        <td class="text-end" t-esc="row.answers ? formatMoney(row.cost / row.answers) : '–'"/>
                                        <td class="text-end" t-att-class="{'text-danger': row.failed}" t-esc="formatNumber(row.failed)"/>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" role="progressbar" t-att-aria-valuenow="share(row)" aria-valuemin="0" aria-valuemax="100">
                                                    <div class="progress-bar" t-att-style="'width:' + share(row) + '%'"/>
                                                </div>
                                                <small class="text-muted" t-esc="share(row) + '%'"/>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <footer class="d-flex flex-wrap gap-3">
                    <button class="btn btn-secondary" t-on-click="openLog"><i class="fa fa-list me-1"/>Detailed request log</button>
                </footer>
            </div>
        </div>
    </t>
</templates>
