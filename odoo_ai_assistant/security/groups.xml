<odoo>
    <!-- Own section on the user's Access Rights tab, placed right after Marketing (sequence 40). -->
    <record model="ir.module.category" id="module_category_ai">
        <field name="name">AI</field>
        <field name="sequence">41</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_ai">
        <field name="name">AI Agent</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_ai"/>
    </record>

    <!-- A single group: the Access Rights tab shows it as No / Yes. -->
    <record id="group_ai_user" model="res.groups">
        <field name="name">Yes</field>
        <field name="comment">Can chat with the AI Agent and confirm the changes it prepares, within the user's own Odoo access rights, when AI changes are allowed in AI Settings.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
