<odoo>
    <record id="conversation_owner_rule" model="ir.rule">
        <field name="name">AI conversations: owner only</field>
        <field name="model_id" ref="model_odoo_ai_assistant_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="message_owner_rule" model="ir.rule">
        <field name="name">AI messages: conversation owner only</field>
        <field name="model_id" ref="model_odoo_ai_assistant_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
